# ============================================================================
# UK Takeaway Phone Order Assistant Dashboard - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in the actual values for development
# DO NOT commit .env.local to version control

# ----------------------------------------------------------------------------
# NextAuth Configuration
# ----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# URL of the Next.js application (update for production)
# Vercel'de: https://your-app.vercel.app (veya kendi domain'in)
NEXTAUTH_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# Google OAuth
# ----------------------------------------------------------------------------
# 1. https://console.cloud.google.com/ → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID → Web application
# 3. Authorized redirect URIs'e EKLE:
#    - Local:  http://localhost:3000/api/auth/callback/google
#    - Vercel: https://YOUR-DOMAIN.vercel.app/api/auth/callback/google
# 4. Vercel → Settings → Environment Variables:
#    GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, NEXTAUTH_URL (production URL)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ----------------------------------------------------------------------------
# Apple Sign-In
# ----------------------------------------------------------------------------
# Get credentials from: https://developer.apple.com/
# Create App ID with Sign In with Apple capability
# Create a private key in the Certificates, Identifiers & Profiles section
APPLE_ID="your-apple-services-id"
APPLE_TEAM_ID="your-apple-team-id"
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_KEY_ID="your-apple-key-id"

# ----------------------------------------------------------------------------
# Retell AI Integration
# ----------------------------------------------------------------------------
# Get API key from: https://www.retellai.com/dashboard
RETELL_API_KEY="your-retell-api-key"

# ----------------------------------------------------------------------------
# n8n MCP Server
# ----------------------------------------------------------------------------
# MCP server endpoint for accessing n8n workflows
MCP_SERVER_ENDPOINT="https://nt3ys1ml.rpcd.host/mcp-server/http"
MCP_AUTH_TOKEN="your-mcp-auth-token"

# ----------------------------------------------------------------------------
# Cloudflare Configuration
# ----------------------------------------------------------------------------
# Get from: https://dash.cloudflare.com/
# Used for D1 database deployment and Cloudflare Pages
CLOUDFLARE_ACCOUNT_ID="your-account-id"
CLOUDFLARE_API_TOKEN="your-api-token"

# ----------------------------------------------------------------------------
# Database (Cloudflare D1)
# ----------------------------------------------------------------------------
# Database name configured in wrangler.toml
# Run: wrangler d1 create takeaway-dashboard
# Then update the database_id in wrangler.toml
D1_DATABASE_NAME="takeaway-dashboard"

# ----------------------------------------------------------------------------
# Stripe Integration
# ----------------------------------------------------------------------------
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Optional: shared secret for n8n -> dashboard forwarded Retell call_ended events.
# If omitted, the dashboard falls back to CRON_SECRET for trusted internal forwards.
RETELL_FORWARD_SECRET="generate-a-random-shared-secret"

# ----------------------------------------------------------------------------
# SMTP / Invite Emails
# ----------------------------------------------------------------------------
# Used by the admin panel to send generated credentials to new customers.
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="noreply@example.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM_EMAIL="noreply@example.com"
SMTP_FROM_NAME="MGL Systems"

# ----------------------------------------------------------------------------
# Twilio / Direct SMS Alerts
# ----------------------------------------------------------------------------
# Used by package usage alerts at 20% and 10% remaining.
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+447..."

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------
# Node environment (development, production, test)
NODE_ENV="development"

# Log level (error, warn, info, debug)
LOG_LEVEL="info"

# Shared secret already used by cron endpoints.
# Can also be reused by n8n forwarding if RETELL_FORWARD_SECRET is not set.
CRON_SECRET="generate-a-random-shared-secret"
